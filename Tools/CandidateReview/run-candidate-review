#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
BUILD_DIR="${TMPDIR:-/tmp}/chronobeat-candidate-review"
EXECUTABLE="$BUILD_DIR/run-candidate-review"

mkdir -p "$BUILD_DIR"
xcrun swiftc -O \
  "$REPO_ROOT/Sources/WatchAccuracyMeter/AudioCapture.swift" \
  "$REPO_ROOT/Sources/WatchAccuracyMeter/CandidateReview.swift" \
  "$REPO_ROOT/Sources/WatchAccuracyMeter/TickCandidateFeatures.swift" \
  "$REPO_ROOT/Sources/WatchAccuracyMeter/WatchDSP.swift" \
  "$SCRIPT_DIR/main.swift" \
  -o "$EXECUTABLE"

CHRONOBEAT_REVIEW_TEMPLATE="$SCRIPT_DIR/template.html" \
  exec "$EXECUTABLE" "$@"
